# デプロイ先の種別（local / production）。production では起動時のシード処理を実行しない
ENVIRONMENT=local
# 初期データ投入プロファイル（none / development / e2e）
SEED_PROFILE=development
# access_token Cookie の Secure 属性。ローカル(HTTP)は false、本番(HTTPS)では true にすること
COOKIE_SECURE=false

# フロントエンドのオリジン（CORS 設定）
FRONTEND_BASE_URL=http://localhost:5173

DB_CONNECTION=mysql
MYSQL_HOST=db
MYSQL_PORT=3306
# MySQLコンテナのrootパスワード。ローカル専用の値。本番では絶対に使い回さないこと
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=crm
MYSQL_USER=user
# アプリからのDB接続パスワード。ローカル専用の値。本番では絶対に使い回さないこと
MYSQL_PASSWORD=pass

# JWT署名鍵。各自で生成すること（例: python -c "import secrets; print(secrets.token_urlsafe(64))"）
# 本番では絶対に使い回さないこと
SECRET_KEY=please-generate-your-own-secret-key
JWT_ALGORITHM=HS256
# アクセストークンの有効期限（分）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 初期管理者アカウント。ローカル専用の値。本番では絶対に使い回さないこと
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password
